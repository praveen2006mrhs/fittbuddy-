# ==========================================
# FitBuddy Environment Configuration
# ==========================================

# Application Settings
APP_NAME=FitBuddy
APP_ENV=development
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Session / Authentication Security
# Generate a secure random string for production
SESSION_SECRET=fitbuddy-super-secret-session-key-change-me

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///./fitbuddy.db

# Google Gemini API Settings
# Server-only: Never exposed to the browser or client-side scripts.
# Obtain your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configurable Gemini Model Selection
# Models for workouts and tips are configured separately, though they can point to the same model.
# Examples: gemini-2.5-flash, gemini-2.0-flash, gemini-2.5-pro, etc.
GEMINI_WORKOUT_MODEL=gemini-2.5-flash
GEMINI_TIP_MODEL=gemini-2.5-flash

# Operational Parameters (Timeouts and Bounded Retries)
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY_SECONDS=1.0

# Development Mock Mode
# Set to 'true' ONLY to enable deterministic mock responses for local testing without an API key.
# When 'false' (default), FitBuddy performs live API requests.
# Live failures NEVER fall back to mock data.
GEMINI_MOCK_ENABLED=false
